<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The app's colours (src/styles/tokens.css): the launch screen, and what
         Android draws over the page (text selection handles, the cursor,
         overscroll) use them instead of Material's purple. Dark theme (values-night/widget_colors.xml). -->
    <style name="Theme.nisshoku_app" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/widget_accent</item>
        <item name="colorAccent">@color/widget_accent</item>
        <item name="colorControlActivated">@color/widget_accent</item>
        <item name="android:colorControlActivated">@color/widget_accent</item>
        <item name="android:textColorHighlight">@color/widget_accent_soft</item>
        <item name="android:windowBackground">@color/widget_bg</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/widget_bg</item>
    </style>
</resources>
